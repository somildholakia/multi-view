# Copy to .env. Replace the example token with a long random secret.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
API_AUTH_TOKEN=replace-with-a-long-random-secret

# Used by the pnpm dev workflow on the host.
MONGODB_URI=mongodb://127.0.0.1:27017/multiview_qa
REDIS_URL=redis://127.0.0.1:6379

# Exact FQDNs for media servers you own or are authorized to test.
# Add each CDN hostname separately. Wildcards and implicit subdomains are not allowed.
ALLOWED_MEDIA_HOSTS=media.example.com
WORKER_REGION=local-lab

# Worker guardrails
MAX_CONCURRENCY=12
MAX_TARGET_SESSIONS=100000

# Optional Docker settings
WEB_PORT=8080
API_PORT=4000
WEB_ORIGIN_DOCKER=http://localhost:8080
VITE_API_URL=http://localhost:4000
