# Copy this file to .env and configure your own services.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
API_AUTH_TOKEN=change-this-long-random-token

MONGODB_URI=mongodb://127.0.0.1:27017/multiview_qa
REDIS_URL=redis://127.0.0.1:6379

# Exact hostnames you own or are authorized to test. No wildcards.
ALLOWED_MEDIA_HOSTS=media.example.com
WORKER_REGION=local-lab

# Browser worker guardrails
MAX_CONCURRENCY=12
MAX_TARGET_SESSIONS=100000
